# ─────────────────────────────────────────────────────────────────────────────
# Call Center Staffing — environment reference
#
# NOTE: The site currently works WITHOUT any of these set because the production
# public values have source fallbacks. Prefer setting them in hosting so rebrands
# and analytics changes do not require code edits.
#
# The only real SECRET (reCAPTCHA secret key) is NOT here — it is configured in
# the SplitForms dashboard, never in the app or repo.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (used for canonical tags, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.callcenterstaffing.net

# Google reCAPTCHA v2 — SITE key (public; goes in the page). Registered for callcenterstaffing.net
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Ld_Fw8tAAAAAGmZm1aBgugZA434TfkJWlhkUzEP
# reCAPTCHA SECRET key  ->  do NOT put it here. Paste it into the SplitForms dashboard.

# SplitForms form-submission access key (server-side only; never expose with NEXT_PUBLIC_)
# REQUIRED — the app returns a 500 on form submit if this is unset.
# The value previously committed here has been exposed and MUST be rotated in SplitForms.
SPLITFORMS_ACCESS_KEY=your-splitforms-access-key

# Analytics & verification (all public)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-B7QE452XJX
NEXT_PUBLIC_CLARITY_PROJECT_ID=x2dgwn3f7g
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=1ffyhqmcj-JRp9k1GZOGD6pcBK4dB844HbEuYaoI9D4
